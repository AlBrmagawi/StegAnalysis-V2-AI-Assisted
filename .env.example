# Native settings: set these in your shell or service environment.
# No automatic .env loading; do not put secrets in frontend/VITE variables.
STEG_DATA_DIR=.data
# Optional locally evaluated JSON ML weights (not provided by default):
# STEG_ML_MODEL=D:/stageanalysis/ml-output/model.json
# Ollama must be listening on loopback; no model downloaded by this application:
# STEG_LOCAL_URL=http://127.0.0.1:11434
# STEG_LOCAL_MODEL=your-installed-model
# Hosted OpenAI-compatible Chat Completions endpoint; UI requires per-request consent:
# STEG_HOSTED_URL=https://your-provider.example/v1/chat/completions
# STEG_HOSTED_MODEL=your-model
# STEG_HOSTED_KEY=server-side-secret
